---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS, CATEGORIES } from '../data/products';

const serializedProducts = JSON.stringify(PRODUCTS);
const serializedCategories = JSON.stringify(CATEGORIES);
---

<Layout title="Mis compras">
  <div class="minimal-page">
    <!-- CABECERA ULTRA LIMPIA -->
    <header class="top-bar">
      <div class="top-bar-inner">
        <div class="title-group">
          <h1 class="page-title">Mis compras</h1>
          <span class="subtle-count" id="items-counter">0</span>
        </div>

        <div class="top-controls">
          <!-- Selector discreto Pendientes / Listos / Descartados -->
          <div class="segmented-switch" role="tablist">
            <button
              type="button"
              id="tab-pending"
              class="seg-btn active"
              role="tab"
              aria-selected="true"
            >
              Pendientes
            </button>
            <button
              type="button"
              id="tab-bought"
              class="seg-btn"
              role="tab"
              aria-selected="false"
            >
              Listos <span id="bought-dot" class="seg-num" hidden>0</span>
            </button>
            <button
              type="button"
              id="tab-discarded"
              class="seg-btn"
              role="tab"
              aria-selected="false"
            >
              Descartados <span id="discarded-dot" class="seg-num" hidden>0</span>
            </button>
          </div>
        </div>
      </div>

      <!-- BUSCADOR SUAVE Y CATEGORÍAS -->
      <div class="filter-bar">
        <div class="search-box">
          <svg class="search-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="search-input"
            class="minimal-search"
            placeholder="Buscar..."
            autocomplete="off"
          />
          <button type="button" id="clear-search-btn" class="clear-btn" hidden aria-label="Limpiar">
            ✕
          </button>
        </div>

        <nav class="pills-nav" id="category-strip" aria-label="Categorías">
          <!-- Pastillas minimalistas -->
        </nav>
      </div>
    </header>

    <!-- GALERÍA LIMPIA -->
    <main class="content-area">
      <div id="status-header-bar" class="bought-header-bar" hidden>
        <span id="status-header-label">Cosas que ya compraste</span>
        <button type="button" id="reset-status-btn" class="text-btn">
          Restaurar todo
        </button>
      </div>

      <section id="product-grid" class="minimal-grid" aria-live="polite">
        <!-- Tarjetas minimalistas -->
      </section>

      <!-- ESTADO VACÍO TRANQUILO -->
      <section id="empty-state" class="minimal-empty" hidden>
        <p class="empty-title" id="empty-title">No hay productos aquí</p>
        <p class="empty-sub" id="empty-desc">
          Todo lo de esta categoría ya fue comprado o aún no hay elementos guardados.
        </p>
        <button type="button" id="empty-reset-filters-btn" class="pill-outline-btn">
          Ver pendientes
        </button>
      </section>
    </main>

    <!-- AVISO DISCRETO PARA DESHACER -->
    <div id="undo-toast" class="minimal-toast" hidden role="status">
      <span id="toast-msg">Actualizado</span>
      <button type="button" id="toast-undo-btn" class="toast-undo">
        Deshacer
      </button>
    </div>

    <!-- DETALLE DEL PRODUCTO (Hoja limpia al tocar un producto) -->
    <div id="detail-modal" class="backdrop" hidden aria-hidden="true">
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="sheet-drag" id="close-detail-handle">
          <span></span>
        </div>

        <div class="sheet-media">
          <div id="modal-carousel" class="sheet-carousel"></div>
          <button type="button" id="close-detail-modal" class="sheet-close-circle" aria-label="Cerrar">
            ✕
          </button>
        </div>
        <div id="modal-thumbs" class="sheet-thumbs" hidden></div>

        <div class="sheet-body">
          <div class="sheet-head">
            <div>
              <p class="sheet-cat" id="modal-category">Perfumes</p>
              <h2 class="sheet-name" id="modal-title">Nombre</h2>
            </div>
            <p class="sheet-price" id="modal-price"></p>
          </div>

          <div class="sheet-meta-list" id="modal-specs"></div>

          <div class="sheet-note-box" id="modal-notes-box">
            <p id="modal-notes"></p>
          </div>

          <!-- ACCIONES EN EL DETALLE (Opción 1: Limpia afuera, completa adentro) -->
          <div class="sheet-action-row" id="modal-pending-actions">
            <button type="button" id="modal-discard-btn" class="discard-action-btn">
              ✕ Descartar
            </button>
            <button type="button" id="modal-buy-btn" class="primary-action-btn">
              ✓ Comprado
            </button>
          </div>

          <button type="button" id="modal-restore-btn" class="secondary-action-btn" hidden>
            ↩ Devolver a pendientes
          </button>
        </div>
      </div>
    </div>
  </div>

  <script
    is:inline
    define:vars={{ serializedProducts, serializedCategories }}
  >
    window.__INITIAL_PRODUCTS__ = JSON.parse(serializedProducts);
    window.__CATEGORIES__ = JSON.parse(serializedCategories);
  </script>

  <script>
    import type { ProductItem } from '../data/products';

    declare global {
      interface Window {
        __INITIAL_PRODUCTS__: ProductItem[];
        __CATEGORIES__: Array<{ id: string; label: string }>;
      }
    }

    const STORAGE_KEY_BOUGHT = 'personal_sales_bought_ids_v1';
    const STORAGE_KEY_DISCARDED = 'personal_sales_discarded_ids_v1';

    type TabStatus = 'pending' | 'bought' | 'discarded';

    let boughtIds = new Set<string>();
    let discardedIds = new Set<string>();
    let currentStatusTab: TabStatus = 'pending';
    let currentCategory = 'Todos';
    let searchQuery = '';

    // Historial de última acción para el botón "Deshacer"
    let lastAction: {
      id: string;
      prevBought: boolean;
      prevDiscarded: boolean;
    } | null = null;

    let toastTimer: number | null = null;
    let activeModalProductId: string | null = null;

    function loadPersistedState() {
      try {
        const rawBought = localStorage.getItem(STORAGE_KEY_BOUGHT);
        if (rawBought) boughtIds = new Set(JSON.parse(rawBought));

        const rawDiscarded = localStorage.getItem(STORAGE_KEY_DISCARDED);
        if (rawDiscarded) discardedIds = new Set(JSON.parse(rawDiscarded));
      } catch (e) {
        console.error(e);
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY_BOUGHT, JSON.stringify([...boughtIds]));
        localStorage.setItem(STORAGE_KEY_DISCARDED, JSON.stringify([...discardedIds]));
      } catch (e) {
        console.error(e);
      }
    }

    function getAllProducts(): ProductItem[] {
      return window.__INITIAL_PRODUCTS__ || [];
    }

    function formatCOP(value?: number): string {
      if (!value || isNaN(value)) return '';
      return new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: 'COP',
        maximumFractionDigits: 0,
      }).format(value);
    }

    function normalizeText(str: string): string {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function matchesSearch(item: ProductItem, query: string): boolean {
      if (!query.trim()) return true;
      const terms = normalizeText(query).split(/\s+/).filter(Boolean);
      const haystack = normalizeText(
        [
          item.name,
          item.category,
          item.spec,
          item.colorway,
          item.storeHint,
          item.notes,
          ...(item.tags || []),
        ].join(' ')
      );
      return terms.every((t) => haystack.includes(t));
    }

    function formatCategoryName(str: string): string {
      if (!str) return '';
      return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
    }

    function renderApp() {
      const allProducts = getAllProducts();
      const pendingProducts = allProducts.filter(
        (p) => !boughtIds.has(p.id) && !discardedIds.has(p.id)
      );
      const boughtProducts = allProducts.filter((p) => boughtIds.has(p.id));
      const discardedProducts = allProducts.filter((p) => discardedIds.has(p.id));

      const basePool =
        currentStatusTab === 'pending'
          ? pendingProducts
          : currentStatusTab === 'bought'
          ? boughtProducts
          : discardedProducts;

      // Contador junto al título
      const counterEl = document.getElementById('items-counter');
      if (counterEl) counterEl.textContent = String(basePool.length);

      // Contadores en las pestañas Listos y Descartados
      const boughtDotEl = document.getElementById('bought-dot');
      if (boughtDotEl) {
        boughtDotEl.textContent = String(boughtProducts.length);
        boughtDotEl.hidden = boughtProducts.length === 0;
      }

      const discardedDotEl = document.getElementById('discarded-dot');
      if (discardedDotEl) {
        discardedDotEl.textContent = String(discardedProducts.length);
        discardedDotEl.hidden = discardedProducts.length === 0;
      }

      // Estado activo de los tabs
      document.getElementById('tab-pending')?.classList.toggle('active', currentStatusTab === 'pending');
      document.getElementById('tab-bought')?.classList.toggle('active', currentStatusTab === 'bought');
      document.getElementById('tab-discarded')?.classList.toggle('active', currentStatusTab === 'discarded');

      // Barra superior contextual en Listos o Descartados
      const statusHeaderBar = document.getElementById('status-header-bar');
      const statusHeaderLabel = document.getElementById('status-header-label');
      const resetStatusBtn = document.getElementById('reset-status-btn');

      if (statusHeaderBar && statusHeaderLabel && resetStatusBtn) {
        if (currentStatusTab === 'bought' && boughtProducts.length > 0) {
          statusHeaderBar.hidden = false;
          statusHeaderLabel.textContent = 'Productos que ya compraste';
          resetStatusBtn.textContent = 'Desmarcar todos';
        } else if (currentStatusTab === 'discarded' && discardedProducts.length > 0) {
          statusHeaderBar.hidden = false;
          statusHeaderLabel.textContent = 'Productos que descartaste al probarlos';
          resetStatusBtn.textContent = 'Restaurar todos';
        } else {
          statusHeaderBar.hidden = true;
        }
      }

      // Pastillas de categorías
      const categoryStrip = document.getElementById('category-strip');
      if (categoryStrip) {
        const categories = window.__CATEGORIES__ || [];
        categoryStrip.innerHTML = categories
          .map((cat) => {
            const isActive = currentCategory === cat.id;
            const label = formatCategoryName(cat.label);
            return `
              <button
                type="button"
                class="cat-pill ${isActive ? 'active' : ''}"
                data-category="${cat.id}"
              >
                ${label}
              </button>
            `;
          })
          .join('');
      }

      // Filtrado
      const visibleProducts = basePool.filter((item) => {
        const matchesCat =
          currentCategory === 'Todos' ||
          item.category.toLowerCase() === currentCategory.toLowerCase();
        return matchesCat && matchesSearch(item, searchQuery);
      });

      const gridEl = document.getElementById('product-grid');
      const emptyEl = document.getElementById('empty-state');
      if (!gridEl || !emptyEl) return;

      if (visibleProducts.length === 0) {
        gridEl.hidden = true;
        emptyEl.hidden = false;
        const emptyTitle = document.getElementById('empty-title');
        const emptyDesc = document.getElementById('empty-desc');

        if (currentStatusTab === 'pending') {
          if (emptyTitle) {
            emptyTitle.textContent = searchQuery.trim()
              ? 'Sin resultados'
              : 'Todo listo por aquí';
          }
          if (emptyDesc) {
            emptyDesc.textContent = searchQuery.trim()
              ? 'Intenta buscar con otra palabra.'
              : 'No tienes productos pendientes en esta categoría.';
          }
        } else if (currentStatusTab === 'bought') {
          if (emptyTitle) emptyTitle.textContent = 'Aún no has marcado compras';
          if (emptyDesc) {
            emptyDesc.textContent =
              'Toca el círculo ✓ en cualquier producto cuando ya lo hayas comprado.';
          }
        } else {
          if (emptyTitle) emptyTitle.textContent = 'No tienes productos descartados';
          if (emptyDesc) {
            emptyDesc.textContent =
              'Si pruebas un perfume o zapato en el centro y no te convence, abre su detalle y dale a "Descartar".';
          }
        }
        return;
      }

      gridEl.hidden = false;
      emptyEl.hidden = true;

      // Renderizar tarjetas minimalistas (Solo 1 botón circular limpio afuera)
      gridEl.innerHTML = visibleProducts
        .map((product) => {
          const isBought = boughtIds.has(product.id);
          const isDiscarded = discardedIds.has(product.id);
          const priceFormatted = formatCOP(product.estimatedPrice);
          const details = [product.spec, product.colorway].filter(Boolean).join(' · ');
          const fitClass = product.imageFit === 'contain' ? 'fit-contain' : '';
          const gallery =
            product.images && product.images.length > 0 ? product.images : [product.image];
          const hasMultiple = gallery.length > 1;

          const slidesHtml = gallery
            .map(
              (src, idx) => `
              <div class="item-slide">
                <img
                  src="${src}"
                  alt="${product.name} - foto ${idx + 1}"
                  loading="lazy"
                  class="item-photo"
                />
              </div>
            `
            )
            .join('');

          const dotsHtml = hasMultiple
            ? `<div class="card-dots" aria-hidden="true">${gallery
                .map((_, i) => `<span class="card-dot ${i === 0 ? 'active' : ''}"></span>`)
                .join('')}</div>`
            : '';

          const circleClass = isBought
            ? 'checked'
            : isDiscarded
            ? 'discarded-badge'
            : '';

          const circleIcon = isDiscarded
            ? `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`
            : `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

          return `
            <article class="item-card ${isBought ? 'is-bought' : ''} ${isDiscarded ? 'is-discarded' : ''}" data-id="${product.id}">
              <div class="item-photo-wrap ${fitClass}" data-open-detail="${product.id}">
                <div class="item-carousel" data-card-carousel>
                  ${slidesHtml}
                </div>
                ${dotsHtml}

                <button
                  type="button"
                  class="check-circle ${circleClass}"
                  data-toggle-id="${product.id}"
                  aria-label="${isBought || isDiscarded ? 'Devolver a pendientes' : 'Marcar como comprado'}"
                >
                  ${circleIcon}
                </button>
              </div>

              <div class="item-info" data-open-detail="${product.id}">
                <h2 class="item-name">${product.name}</h2>
                ${details ? `<p class="item-meta">${details}</p>` : ''}
                ${priceFormatted ? `<p class="item-price">${priceFormatted}</p>` : ''}
              </div>
            </article>
          `;
        })
        .join('');
    }

    function setProductState(productId: string, targetState: 'pending' | 'bought' | 'discarded') {
      const product = getAllProducts().find((p) => p.id === productId);
      if (!product) return;

      lastAction = {
        id: productId,
        prevBought: boughtIds.has(productId),
        prevDiscarded: discardedIds.has(productId),
      };

      boughtIds.delete(productId);
      discardedIds.delete(productId);

      if (targetState === 'bought') {
        boughtIds.add(productId);
        showUndoToast(`Comprado: ${product.name}`);
      } else if (targetState === 'discarded') {
        discardedIds.add(productId);
        showUndoToast(`Descartado: ${product.name}`);
      } else {
        hideToast();
      }

      saveState();
      renderApp();
    }

    function showUndoToast(message: string) {
      const toast = document.getElementById('undo-toast');
      const msgEl = document.getElementById('toast-msg');
      if (!toast || !msgEl) return;

      msgEl.textContent = message;
      toast.hidden = false;

      if (toastTimer) window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.hidden = true;
      }, 4000);
    }

    function hideToast() {
      const toast = document.getElementById('undo-toast');
      if (toast) toast.hidden = true;
      if (toastTimer) window.clearTimeout(toastTimer);
    }

    function openDetailModal(productId: string) {
      const product = getAllProducts().find((p) => p.id === productId);
      if (!product) return;

      activeModalProductId = productId;
      const modal = document.getElementById('detail-modal');
      const carouselEl = document.getElementById('modal-carousel');
      const thumbsEl = document.getElementById('modal-thumbs');
      const cat = document.getElementById('modal-category');
      const title = document.getElementById('modal-title');
      const price = document.getElementById('modal-price');
      const specs = document.getElementById('modal-specs');
      const notesBox = document.getElementById('modal-notes-box');
      const notes = document.getElementById('modal-notes');
      const pendingActions = document.getElementById('modal-pending-actions');
      const restoreBtn = document.getElementById('modal-restore-btn');

      if (!modal) return;

      const gallery =
        product.images && product.images.length > 0 ? product.images : [product.image];
      const isContain = product.imageFit === 'contain';

      if (carouselEl) {
        carouselEl.innerHTML = gallery
          .map(
            (src, idx) => `
            <div class="sheet-slide ${isContain ? 'fit-contain' : ''}">
              <img src="${src}" alt="${product.name} - foto ${idx + 1}" />
            </div>
          `
          )
          .join('');
        carouselEl.scrollLeft = 0;
      }

      if (thumbsEl) {
        if (gallery.length > 1) {
          thumbsEl.hidden = false;
          thumbsEl.innerHTML = gallery
            .map(
              (src, idx) => `
              <button type="button" class="thumb-btn ${idx === 0 ? 'active' : ''}" data-thumb-idx="${idx}" aria-label="Ver foto ${idx + 1}">
                <img src="${src}" alt="Miniatura ${idx + 1}" />
              </button>
            `
            )
            .join('');
        } else {
          thumbsEl.hidden = true;
          thumbsEl.innerHTML = '';
        }
      }

      if (cat) cat.textContent = product.category;
      if (title) title.textContent = product.name;
      if (price) price.textContent = formatCOP(product.estimatedPrice);

      if (specs) {
        const rows = [];
        if (product.spec) {
          rows.push(`<div class="meta-row"><span>Referencia / Detalle</span><strong>${product.spec}</strong></div>`);
        }
        if (product.colorway) {
          rows.push(`<div class="meta-row"><span>Notas / Color</span><strong>${product.colorway}</strong></div>`);
        }
        if (product.storeHint) {
          rows.push(`<div class="meta-row"><span>Dónde mirar</span><strong>${product.storeHint}</strong></div>`);
        }
        specs.innerHTML = rows.join('');
        specs.hidden = rows.length === 0;
      }

      if (notesBox && notes) {
        if (product.notes) {
          notesBox.hidden = false;
          notes.textContent = product.notes;
        } else {
          notesBox.hidden = true;
        }
      }

      const isBought = boughtIds.has(productId);
      const isDiscarded = discardedIds.has(productId);

      if (pendingActions && restoreBtn) {
        if (isBought || isDiscarded) {
          pendingActions.hidden = true;
          restoreBtn.hidden = false;
        } else {
          pendingActions.hidden = false;
          restoreBtn.hidden = true;
        }
      }

      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
    }

    function closeDetailModal() {
      const modal = document.getElementById('detail-modal');
      if (modal) {
        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
      }
      activeModalProductId = null;
    }

    function setupEvents() {
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        const catBtn = target.closest('[data-category]') as HTMLElement | null;
        if (catBtn) {
          currentCategory = catBtn.getAttribute('data-category') || 'Todos';
          renderApp();
          return;
        }

        // Botón circular en la esquina de la foto
        const toggleBtn = target.closest('[data-toggle-id]') as HTMLElement | null;
        if (toggleBtn) {
          e.stopPropagation();
          const id = toggleBtn.getAttribute('data-toggle-id');
          if (id) {
            const isAlreadyDone = boughtIds.has(id) || discardedIds.has(id);
            const nextState = isAlreadyDone ? 'pending' : 'bought';
            const card = toggleBtn.closest('.item-card') as HTMLElement | null;
            if (!isAlreadyDone) toggleBtn.classList.add('checked');
            if (card) {
              card.classList.add('fading-out');
              window.setTimeout(() => setProductState(id, nextState), 180);
            } else {
              setProductState(id, nextState);
            }
          }
          return;
        }

        const detailTrigger = target.closest('[data-open-detail]') as HTMLElement | null;
        if (detailTrigger) {
          const id = detailTrigger.getAttribute('data-open-detail');
          if (id) openDetailModal(id);
          return;
        }

        const thumbBtn = target.closest('[data-thumb-idx]') as HTMLElement | null;
        if (thumbBtn) {
          const idx = Number(thumbBtn.getAttribute('data-thumb-idx') || 0);
          const carouselEl = document.getElementById('modal-carousel');
          if (carouselEl) {
            carouselEl.scrollTo({
              left: idx * carouselEl.clientWidth,
              behavior: 'smooth',
            });
          }
          return;
        }
      });

      // Sincronizar miniaturas cuando el usuario desliza con el dedo en el modal
      const modalCarousel = document.getElementById('modal-carousel');
      modalCarousel?.addEventListener(
        'scroll',
        () => {
          if (!modalCarousel.clientWidth) return;
          const idx = Math.round(modalCarousel.scrollLeft / modalCarousel.clientWidth);
          document.querySelectorAll('.thumb-btn').forEach((btn, i) => {
            btn.classList.toggle('active', i === idx);
          });
        },
        { passive: true }
      );

      // Sincronizar puntitos cuando el usuario desliza una tarjeta en la cuadrícula
      document.addEventListener(
        'scroll',
        (e) => {
          const target = e.target as HTMLElement;
          if (target && target.hasAttribute && target.hasAttribute('data-card-carousel')) {
            if (!target.clientWidth) return;
            const idx = Math.round(target.scrollLeft / target.clientWidth);
            const wrap = target.parentElement;
            wrap?.querySelectorAll('.card-dot').forEach((dot, i) => {
              dot.classList.toggle('active', i === idx);
            });
          }
        },
        true
      );

      document.getElementById('tab-pending')?.addEventListener('click', () => {
        currentStatusTab = 'pending';
        renderApp();
      });

      document.getElementById('tab-bought')?.addEventListener('click', () => {
        currentStatusTab = 'bought';
        renderApp();
      });

      document.getElementById('tab-discarded')?.addEventListener('click', () => {
        currentStatusTab = 'discarded';
        renderApp();
      });

      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clear-search-btn');

      searchInput?.addEventListener('input', () => {
        searchQuery = searchInput.value;
        if (clearBtn) clearBtn.hidden = !searchQuery.length;
        renderApp();
      });

      clearBtn?.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          clearBtn.hidden = true;
          renderApp();
        }
      });

      document.getElementById('toast-undo-btn')?.addEventListener('click', () => {
        if (lastAction) {
          const { id, prevBought, prevDiscarded } = lastAction;
          boughtIds.delete(id);
          discardedIds.delete(id);
          if (prevBought) boughtIds.add(id);
          if (prevDiscarded) discardedIds.add(id);
          saveState();
          lastAction = null;
          hideToast();
          renderApp();
        }
      });

      document.getElementById('empty-reset-filters-btn')?.addEventListener('click', () => {
        currentStatusTab = 'pending';
        currentCategory = 'Todos';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        if (clearBtn) clearBtn.hidden = true;
        renderApp();
      });

      document.getElementById('reset-status-btn')?.addEventListener('click', () => {
        if (currentStatusTab === 'bought') {
          boughtIds.clear();
        } else if (currentStatusTab === 'discarded') {
          discardedIds.clear();
        }
        saveState();
        currentStatusTab = 'pending';
        renderApp();
      });

      document.getElementById('close-detail-modal')?.addEventListener('click', closeDetailModal);
      document.getElementById('close-detail-handle')?.addEventListener('click', closeDetailModal);
      document.getElementById('detail-modal')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeDetailModal();
      });

      // Botones dentro del detalle: Comprado / Descartar / Devolver a pendientes
      document.getElementById('modal-buy-btn')?.addEventListener('click', () => {
        if (activeModalProductId) {
          const id = activeModalProductId;
          closeDetailModal();
          setProductState(id, 'bought');
        }
      });

      document.getElementById('modal-discard-btn')?.addEventListener('click', () => {
        if (activeModalProductId) {
          const id = activeModalProductId;
          closeDetailModal();
          setProductState(id, 'discarded');
        }
      });

      document.getElementById('modal-restore-btn')?.addEventListener('click', () => {
        if (activeModalProductId) {
          const id = activeModalProductId;
          closeDetailModal();
          setProductState(id, 'pending');
        }
      });
    }

    loadPersistedState();
    setupEvents();
    renderApp();
  </script>
</Layout>

