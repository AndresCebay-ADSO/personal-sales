---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS, CATEGORIES } from '../data/products';

const serializedProducts = JSON.stringify(PRODUCTS);
const serializedCategories = JSON.stringify(CATEGORIES);
---

<Layout title="COLECCIÓN // Lookbook de Compras">
  <div class="lookbook-app">
    <!-- CABECERA EDITORIAL MINIMALISTA (Estilo New Balance Lookbook / SSENSE) -->
    <header class="editorial-header">
      <div class="header-meta-row">
        <span class="meta-index" id="header-status-tag">POR COMPRAR // 01</span>
        <span class="meta-budget" id="budget-summary">0 PENDIENTES</span>
      </div>

      <div class="header-title-row">
        <h1 class="editorial-title" id="editorial-heading">ZAPATOS</h1>
        <button
          type="button"
          id="top-search-trigger"
          class="minimal-icon-btn"
          aria-label="Buscar en la colección"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7.5"></circle>
            <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
          </svg>
        </button>
      </div>

      <!-- BUSCADOR DESPLEGABLE LIMPIO (Solo ocupa espacio cuando lo usas) -->
      <div id="search-drawer" class="search-drawer" hidden>
        <div class="search-line">
          <input
            type="search"
            id="search-input"
            class="editorial-search-input"
            placeholder="Filtrar por nombre, color, talla, nota..."
            autocomplete="off"
          />
          <button type="button" id="clear-search-btn" class="search-close-btn" aria-label="Cerrar búsqueda">
            CERRAR ✕
          </button>
        </div>
      </div>

      <!-- ÍNDICE TIPOGRÁFICO DE CATEGORÍAS (Sin cajas grises, puro estilo revista) -->
      <nav class="editorial-nav" id="category-strip" aria-label="Categorías">
        <!-- Se hidrata con superíndices numéricos estilo SSENSE -->
      </nav>
    </header>

    <!-- GALERÍA DE PRODUCTOS (Lookbook sin bordes de caja ni botones pesados) -->
    <main class="lookbook-main">
      <div id="bought-banner-actions" class="bought-banner-actions" hidden>
        <span>ESTÁS VIENDO LOS PRODUCTOS QUE YA CHULEASTE</span>
        <button type="button" id="reset-bought-btn" class="text-underline-btn">
          RESTAURAR TODOS
        </button>
      </div>

      <section id="product-grid" class="lookbook-grid cols-2" aria-live="polite">
        <!-- Tarjetas limpias renderizadas dinámicamente -->
      </section>

      <!-- ESTADO VACÍO EDITORIAL -->
      <section id="empty-state" class="editorial-empty" hidden>
        <p class="empty-index">00 // VACÍO</p>
        <h2 class="empty-heading" id="empty-title">SIN PRODUCTOS EN ESTA VISTA</h2>
        <p class="empty-copy" id="empty-desc">
          Ya chuleaste todo aquí o aún no hemos agregado productos a esta categoría.
        </p>
        <button type="button" id="empty-reset-filters-btn" class="editorial-outline-btn">
          VER TODA LA COLECCIÓN
        </button>
      </section>
    </main>

    <!-- TOAST DE DESHACER (Por si chuleas sin querer caminando) -->
    <div id="undo-toast" class="floating-toast" hidden role="status" aria-live="assertive">
      <span class="toast-label" id="toast-msg">Chuleado</span>
      <button type="button" id="toast-undo-btn" class="toast-undo-action">
        DESHACER
      </button>
    </div>

    <!-- DOCK FLOTANTE INFERIOR PARA EL PULGAR (Estilo App Nativa iOS / Shop) -->
    <div class="bottom-dock-wrap">
      <nav class="bottom-dock" aria-label="Controles rápidos">
        <button
          type="button"
          id="dock-tab-pending"
          class="dock-pill active"
          data-status="pending"
        >
          <span>PENDIENTES</span>
          <span class="dock-count" id="count-pending">0</span>
        </button>

        <button
          type="button"
          id="dock-tab-bought"
          class="dock-pill"
          data-status="bought"
        >
          <span>LISTOS ✓</span>
          <span class="dock-count" id="count-bought">0</span>
        </button>

        <span class="dock-divider" aria-hidden="true"></span>

        <button
          type="button"
          id="grid-toggle-btn"
          class="dock-icon-btn"
          title="Alternar 1 o 2 columnas"
          aria-label="Alternar vista de columnas"
        >
          <span id="grid-toggle-label">2×</span>
        </button>

        <button
          type="button"
          id="open-quick-add-btn"
          class="dock-add-btn"
          title="Agregar ítem rápido"
          aria-label="Agregar ítem rápido"
        >
          +
        </button>
      </nav>
    </div>

    <!-- HOJA DESLIZABLE INFERIOR DE DETALLE (Bottom Sheet al tocar un producto) -->
    <div id="detail-modal" class="sheet-backdrop" hidden aria-hidden="true">
      <div class="bottom-sheet" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="sheet-handle-bar" id="close-detail-handle">
          <span class="sheet-pill-indicator"></span>
        </div>

        <div class="sheet-top-bar">
          <span class="sheet-cat-label" id="modal-category">ZAPATOS</span>
          <button type="button" id="close-detail-modal" class="sheet-close-btn">
            CERRAR ✕
          </button>
        </div>

        <div class="sheet-content">
          <div class="sheet-image-stage">
            <img id="modal-image" src="" alt="" />
          </div>

          <div class="sheet-info">
            <div class="sheet-header-block">
              <h2 class="sheet-title" id="modal-title">Nombre</h2>
              <p class="sheet-price" id="modal-price"></p>
            </div>

            <div class="sheet-specs-grid" id="modal-specs"></div>

            <div class="sheet-notes" id="modal-notes-box">
              <span class="sheet-notes-label">NOTA PERSONAL</span>
              <p id="modal-notes"></p>
            </div>

            <div class="sheet-actions">
              <button type="button" id="modal-toggle-btn" class="sheet-cta-btn">
                ✓ MARCAR COMO COMPRADO
              </button>
              <button type="button" id="modal-delete-custom-btn" class="sheet-delete-btn" hidden>
                ELIMINAR RECORDATORIO RÁPIDO
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- HOJA DESLIZABLE PARA AGREGAR ALGO RÁPIDO EN LA CALLE -->
    <div id="quick-add-modal" class="sheet-backdrop" hidden aria-hidden="true">
      <div class="bottom-sheet" role="dialog" aria-modal="true" aria-labelledby="quick-add-heading">
        <div class="sheet-handle-bar">
          <span class="sheet-pill-indicator"></span>
        </div>

        <div class="sheet-top-bar">
          <span class="sheet-cat-label">NUEVO ÍTEM EN EL CELULAR</span>
          <button type="button" id="close-quick-add-modal" class="sheet-close-btn">
            CERRAR ✕
          </button>
        </div>

        <form id="quick-add-form" class="sheet-form">
          <h2 id="quick-add-heading" class="sheet-title">AGREGAR A LA COLECCIÓN</h2>

          <label class="editorial-field">
            <span>PRODUCTO *</span>
            <input type="text" name="name" required placeholder="Ej: New Balance 550 Blancos" />
          </label>

          <div class="field-grid-2">
            <label class="editorial-field">
              <span>CATEGORÍA</span>
              <select name="category">
                <option value="Zapatos">Zapatos</option>
                <option value="Ropa">Ropa</option>
                <option value="Accesorios">Accesorios</option>
                <option value="Tecnología">Tech</option>
              </select>
            </label>

            <label class="editorial-field">
              <span>PRECIO EST. (COP)</span>
              <input type="number" name="estimatedPrice" placeholder="250000" step="1000" />
            </label>
          </div>

          <div class="field-grid-2">
            <label class="editorial-field">
              <span>TALLA / MEDIDA</span>
              <input type="text" name="spec" placeholder="Talla 40" />
            </label>

            <label class="editorial-field">
              <span>COLOR</span>
              <input type="text" name="colorway" placeholder="Blanco / Gris" />
            </label>
          </div>

          <label class="editorial-field">
            <span>DÓNDE BUSCARLO</span>
            <input type="text" name="storeHint" placeholder="Ej: Centro / Palacio Nacional" />
          </label>

          <label class="editorial-field">
            <span>URL DE IMAGEN (OPCIONAL)</span>
            <input type="url" name="image" placeholder="https://..." />
          </label>

          <label class="editorial-field">
            <span>NOTA PERSONAL</span>
            <input type="text" name="notes" placeholder="Detalles a revisar antes de comprar..." />
          </label>

          <button type="submit" class="sheet-cta-btn">
            GUARDAR EN LA COLECCIÓN
          </button>
        </form>
      </div>
    </div>
  </div>

  <script
    is:inline
    define:vars={{ serializedProducts, serializedCategories }}
  >
    window.__INITIAL_PRODUCTS__ = JSON.parse(serializedProducts);
    window.__CATEGORIES__ = JSON.parse(serializedCategories);
  </script>

  <script>
    import type { ProductItem } from '../data/products';

    declare global {
      interface Window {
        __INITIAL_PRODUCTS__: ProductItem[];
        __CATEGORIES__: Array<{ id: string; label: string }>;
      }
    }

    const STORAGE_KEY_BOUGHT = 'personal_sales_bought_ids_v1';
    const STORAGE_KEY_CUSTOM_ITEMS = 'personal_sales_custom_items_v1';
    const STORAGE_KEY_GRID_COLS = 'personal_sales_grid_cols_v1';

    let boughtIds = new Set<string>();
    let customItems: ProductItem[] = [];
    let currentStatusTab: 'pending' | 'bought' = 'pending';
    let currentCategory = 'Todos';
    let searchQuery = '';
    let isSearchOpen = false;
    let gridCols: 1 | 2 = 2;
    let lastCheckedId: string | null = null;
    let toastTimer: number | null = null;
    let activeModalProductId: string | null = null;

    function loadPersistedState() {
      try {
        const rawBought = localStorage.getItem(STORAGE_KEY_BOUGHT);
        if (rawBought) boughtIds = new Set(JSON.parse(rawBought));

        const rawCustom = localStorage.getItem(STORAGE_KEY_CUSTOM_ITEMS);
        if (rawCustom) customItems = JSON.parse(rawCustom);

        const savedCols = localStorage.getItem(STORAGE_KEY_GRID_COLS);
        if (savedCols === '1' || savedCols === '2') {
          gridCols = Number(savedCols) as 1 | 2;
        }
      } catch (e) {
        console.error(e);
      }
    }

    function saveBoughtState() {
      try {
        localStorage.setItem(STORAGE_KEY_BOUGHT, JSON.stringify([...boughtIds]));
      } catch (e) {
        console.error(e);
      }
    }

    function saveCustomItems() {
      try {
        localStorage.setItem(STORAGE_KEY_CUSTOM_ITEMS, JSON.stringify(customItems));
      } catch (e) {
        console.error(e);
      }
    }

    function getAllProducts(): ProductItem[] {
      return [...customItems, ...(window.__INITIAL_PRODUCTS__ || [])];
    }

    function formatCOP(value?: number): string {
      if (!value || isNaN(value)) return '';
      return new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: 'COP',
        maximumFractionDigits: 0,
      }).format(value);
    }

    function padTwo(n: number): string {
      return String(n).padStart(2, '0');
    }

    function normalizeText(str: string): string {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function matchesSearch(item: ProductItem, query: string): boolean {
      if (!query.trim()) return true;
      const terms = normalizeText(query).split(/\s+/).filter(Boolean);
      const haystack = normalizeText(
        [
          item.name,
          item.category,
          item.spec,
          item.colorway,
          item.storeHint,
          item.notes,
          ...(item.tags || []),
        ].join(' ')
      );
      return terms.every((t) => haystack.includes(t));
    }

    function renderApp() {
      const allProducts = getAllProducts();
      const pendingProducts = allProducts.filter((p) => !boughtIds.has(p.id));
      const boughtProducts = allProducts.filter((p) => boughtIds.has(p.id));

      // Contadores en el Dock inferior
      const countPendingEl = document.getElementById('count-pending');
      const countBoughtEl = document.getElementById('count-bought');
      if (countPendingEl) countPendingEl.textContent = String(pendingProducts.length);
      if (countBoughtEl) countBoughtEl.textContent = String(boughtProducts.length);

      // Estado del Dock
      const dockPending = document.getElementById('dock-tab-pending');
      const dockBought = document.getElementById('dock-tab-bought');
      dockPending?.classList.toggle('active', currentStatusTab === 'pending');
      dockBought?.classList.toggle('active', currentStatusTab === 'bought');

      // Cabecera editorial (meta + título dinámico)
      const statusTagEl = document.getElementById('header-status-tag');
      const budgetSummaryEl = document.getElementById('budget-summary');
      const editorialHeadingEl = document.getElementById('editorial-heading');
      const boughtBannerEl = document.getElementById('bought-banner-actions');

      const basePool = currentStatusTab === 'pending' ? pendingProducts : boughtProducts;
      const totalMoney = basePool.reduce((acc, p) => acc + (p.estimatedPrice || 0), 0);

      if (statusTagEl) {
        statusTagEl.textContent =
          currentStatusTab === 'pending' ? 'LOOKBOOK // POR COMPRAR' : 'ARCHIVO // YA COMPRADOS';
      }

      if (budgetSummaryEl) {
        const moneyStr = totalMoney > 0 ? ` · ${formatCOP(totalMoney)}` : '';
        budgetSummaryEl.textContent = `${padTwo(basePool.length)} ITEMS${moneyStr}`;
      }

      if (editorialHeadingEl) {
        if (searchQuery.trim()) {
          editorialHeadingEl.textContent = `"${searchQuery.toUpperCase()}"`;
        } else if (currentCategory === 'Todos') {
          editorialHeadingEl.textContent = currentStatusTab === 'pending' ? 'COLECCIÓN' : 'COMPRADOS';
        } else {
          editorialHeadingEl.textContent = currentCategory.toUpperCase();
        }
      }

      if (boughtBannerEl) {
        boughtBannerEl.hidden = !(currentStatusTab === 'bought' && boughtProducts.length > 0);
      }

      // Renderizar índice tipográfico de categorías (Estilo SSENSE / Zara)
      const categoryStrip = document.getElementById('category-strip');
      if (categoryStrip) {
        const categories = window.__CATEGORIES__ || [];
        categoryStrip.innerHTML = categories
          .map((cat) => {
            const count =
              cat.id === 'Todos'
                ? basePool.length
                : basePool.filter((p) => p.category.toLowerCase() === cat.id.toLowerCase()).length;
            const isActive = currentCategory === cat.id;
            return `
              <button
                type="button"
                class="editorial-cat-link ${isActive ? 'active' : ''} ${count === 0 && cat.id !== 'Todos' ? 'is-empty' : ''}"
                data-category="${cat.id}"
              >
                <span>${cat.label}</span>
                <sup class="cat-sup">${padTwo(count)}</sup>
              </button>
            `;
          })
          .join('');
      }

      // Filtrar productos visibles
      const visibleProducts = basePool.filter((item) => {
        const matchesCat =
          currentCategory === 'Todos' ||
          item.category.toLowerCase() === currentCategory.toLowerCase();
        return matchesCat && matchesSearch(item, searchQuery);
      });

      // Columnas (1x o 2x)
      const gridEl = document.getElementById('product-grid');
      const emptyEl = document.getElementById('empty-state');
      const gridToggleLabel = document.getElementById('grid-toggle-label');

      if (gridToggleLabel) {
        gridToggleLabel.textContent = gridCols === 2 ? '2×' : '1×';
      }

      if (!gridEl || !emptyEl) return;

      gridEl.classList.toggle('cols-1', gridCols === 1);
      gridEl.classList.toggle('cols-2', gridCols === 2);

      if (visibleProducts.length === 0) {
        gridEl.hidden = true;
        emptyEl.hidden = false;
        const emptyTitle = document.getElementById('empty-title');
        const emptyDesc = document.getElementById('empty-desc');

        if (currentStatusTab === 'pending') {
          if (emptyTitle) {
            emptyTitle.textContent = searchQuery.trim()
              ? 'SIN COINCIDENCIAS'
              : currentCategory === 'Todos'
              ? 'COLECCIÓN COMPLETADA ✓'
              : `SIN PENDIENTES EN ${currentCategory.toUpperCase()}`;
          }
          if (emptyDesc) {
            emptyDesc.textContent = searchQuery.trim()
              ? 'Intenta con otra palabra clave.'
              : 'Todos los ítems de esta sección ya fueron chuleados o aún no hemos agregado productos aquí.';
          }
        } else {
          if (emptyTitle) emptyTitle.textContent = 'NINGÚN PRODUCTO CHULEADO AÚN';
          if (emptyDesc) {
            emptyDesc.textContent =
              'Toca el botón ✓ en la esquina de cualquier producto cuando lo compres en el centro.';
          }
        }
        return;
      }

      gridEl.hidden = false;
      emptyEl.hidden = true;

      // Renderizar tarjetas limpias tipo Lookbook (Sin bordes, sin botones gigantes abajo)
      gridEl.innerHTML = visibleProducts
        .map((product, idx) => {
          const isBought = boughtIds.has(product.id);
          const priceFormatted = formatCOP(product.estimatedPrice);
          const indexStr = padTwo(idx + 1);

          const metaParts = [product.category.toUpperCase()];
          if (product.spec) metaParts.push(product.spec.toUpperCase());

          const subParts = [];
          if (product.colorway) subParts.push(product.colorway);
          if (priceFormatted) subParts.push(priceFormatted);

          return `
            <article class="lookbook-item ${isBought ? 'is-bought' : ''}" data-id="${product.id}">
              <div class="lookbook-media" data-open-detail="${product.id}">
                <img
                  src="${product.image || 'https://images.unsplash.com/photo-1539185441755-769473a23570?auto=format&fit=crop&w=900&q=80'}"
                  alt="${product.name}"
                  loading="lazy"
                  class="lookbook-img"
                />

                <span class="item-index-tag">${indexStr}</span>

                ${
                  product.priority === 'alta' && !isBought
                    ? `<span class="item-priority-dot" title="Prioridad alta"></span>`
                    : ''
                }

                <!-- BOTÓN MINIMALISTA DE CHULEAR EN LA ESQUINA DE LA FOTO -->
                <button
                  type="button"
                  class="quick-check-trigger ${isBought ? 'checked' : ''}"
                  data-toggle-id="${product.id}"
                  aria-label="${isBought ? 'Desmarcar compra' : 'Chulear como comprado'}"
                  title="${isBought ? 'Devolver a pendientes' : 'Chulear compra'}"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" stroke-linejoin="miter">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </button>
              </div>

              <div class="lookbook-caption" data-open-detail="${product.id}">
                <p class="caption-overline">${metaParts.join(' · ')}</p>
                <h2 class="caption-title">${product.name}</h2>
                <p class="caption-sub">${subParts.join(' — ')}</p>
              </div>
            </article>
          `;
        })
        .join('');
    }

    function toggleProductBought(productId: string) {
      const product = getAllProducts().find((p) => p.id === productId);
      if (!product) return;

      if (boughtIds.has(productId)) {
        boughtIds.delete(productId);
        hideToast();
      } else {
        boughtIds.add(productId);
        lastCheckedId = productId;
        showUndoToast(`✓ ${product.name}`);
      }

      saveBoughtState();
      renderApp();
    }

    function showUndoToast(message: string) {
      const toast = document.getElementById('undo-toast');
      const msgEl = document.getElementById('toast-msg');
      if (!toast || !msgEl) return;

      msgEl.textContent = message;
      toast.hidden = false;

      if (toastTimer) window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.hidden = true;
      }, 4200);
    }

    function hideToast() {
      const toast = document.getElementById('undo-toast');
      if (toast) toast.hidden = true;
      if (toastTimer) window.clearTimeout(toastTimer);
    }

    function openDetailModal(productId: string) {
      const product = getAllProducts().find((p) => p.id === productId);
      if (!product) return;

      activeModalProductId = productId;
      const modal = document.getElementById('detail-modal');
      const img = document.getElementById('modal-image') as HTMLImageElement | null;
      const cat = document.getElementById('modal-category');
      const title = document.getElementById('modal-title');
      const price = document.getElementById('modal-price');
      const specs = document.getElementById('modal-specs');
      const notesBox = document.getElementById('modal-notes-box');
      const notes = document.getElementById('modal-notes');
      const toggleBtn = document.getElementById('modal-toggle-btn');
      const deleteCustomBtn = document.getElementById('modal-delete-custom-btn');

      if (!modal) return;

      if (img) {
        img.src =
          product.image ||
          'https://images.unsplash.com/photo-1539185441755-769473a23570?auto=format&fit=crop&w=900&q=80';
        img.alt = product.name;
      }
      if (cat) cat.textContent = `${product.category.toUpperCase()} // DETALLE`;
      if (title) title.textContent = product.name;
      if (price) price.textContent = formatCOP(product.estimatedPrice);

      if (specs) {
        const rows = [];
        if (product.spec) {
          rows.push(`<div class="spec-cell"><span class="spec-k">TALLA / REF</span><span class="spec-v">${product.spec}</span></div>`);
        }
        if (product.colorway) {
          rows.push(`<div class="spec-cell"><span class="spec-k">COLOR</span><span class="spec-v">${product.colorway}</span></div>`);
        }
        if (product.storeHint) {
          rows.push(`<div class="spec-cell full"><span class="spec-k">DÓNDE BUSCAR</span><span class="spec-v">${product.storeHint}</span></div>`);
        }
        specs.innerHTML = rows.join('');
        specs.hidden = rows.length === 0;
      }

      if (notesBox && notes) {
        if (product.notes) {
          notesBox.hidden = false;
          notes.textContent = product.notes;
        } else {
          notesBox.hidden = true;
        }
      }

      const isBought = boughtIds.has(productId);
      if (toggleBtn) {
        toggleBtn.textContent = isBought ? '↩ DEVOLVER A PENDIENTES' : '✓ CHULEAR COMPRA';
        toggleBtn.className = isBought ? 'sheet-outline-btn' : 'sheet-cta-btn';
      }

      const isCustom = customItems.some((c) => c.id === productId);
      if (deleteCustomBtn) {
        deleteCustomBtn.hidden = !isCustom;
      }

      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
    }

    function closeDetailModal() {
      const modal = document.getElementById('detail-modal');
      if (modal) {
        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
      }
      activeModalProductId = null;
    }

    function setupEvents() {
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        // 1. Categoría
        const catBtn = target.closest('[data-category]') as HTMLElement | null;
        if (catBtn) {
          currentCategory = catBtn.getAttribute('data-category') || 'Todos';
          renderApp();
          return;
        }

        // 2. Botón rápido de chulear en la esquina de la foto
        const toggleBtn = target.closest('[data-toggle-id]') as HTMLElement | null;
        if (toggleBtn) {
          e.stopPropagation();
          const id = toggleBtn.getAttribute('data-toggle-id');
          if (id) {
            const card = toggleBtn.closest('.lookbook-item') as HTMLElement | null;
            toggleBtn.classList.add('checked');
            if (card) {
              card.classList.add('checking-out');
              window.setTimeout(() => toggleProductBought(id), 200);
            } else {
              toggleProductBought(id);
            }
          }
          return;
        }

        // 3. Abrir hoja de detalle al tocar foto o texto
        const detailTrigger = target.closest('[data-open-detail]') as HTMLElement | null;
        if (detailTrigger) {
          const id = detailTrigger.getAttribute('data-open-detail');
          if (id) openDetailModal(id);
          return;
        }
      });

      // Dock inferior: Pendientes vs Listos
      document.getElementById('dock-tab-pending')?.addEventListener('click', () => {
        currentStatusTab = 'pending';
        renderApp();
      });

      document.getElementById('dock-tab-bought')?.addEventListener('click', () => {
        currentStatusTab = 'bought';
        renderApp();
      });

      // Buscador desplegable
      const searchDrawer = document.getElementById('search-drawer');
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

      document.getElementById('top-search-trigger')?.addEventListener('click', () => {
        isSearchOpen = !isSearchOpen;
        if (searchDrawer) searchDrawer.hidden = !isSearchOpen;
        if (isSearchOpen && searchInput) {
          searchInput.focus();
        } else if (!isSearchOpen && searchInput) {
          searchInput.value = '';
          searchQuery = '';
          renderApp();
        }
      });

      searchInput?.addEventListener('input', () => {
        searchQuery = searchInput.value;
        renderApp();
      });

      document.getElementById('clear-search-btn')?.addEventListener('click', () => {
        isSearchOpen = false;
        if (searchDrawer) searchDrawer.hidden = true;
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        renderApp();
      });

      // Cambiar columnas 2x / 1x
      document.getElementById('grid-toggle-btn')?.addEventListener('click', () => {
        gridCols = gridCols === 2 ? 1 : 2;
        try {
          localStorage.setItem(STORAGE_KEY_GRID_COLS, String(gridCols));
        } catch {}
        renderApp();
      });

      // Toast Deshacer
      document.getElementById('toast-undo-btn')?.addEventListener('click', () => {
        if (lastCheckedId) {
          boughtIds.delete(lastCheckedId);
          saveBoughtState();
          lastCheckedId = null;
          hideToast();
          renderApp();
        }
      });

      // Reset filtros en vista vacía
      document.getElementById('empty-reset-filters-btn')?.addEventListener('click', () => {
        currentStatusTab = 'pending';
        currentCategory = 'Todos';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        if (searchDrawer) searchDrawer.hidden = true;
        isSearchOpen = false;
        renderApp();
      });

      // Restaurar todos los comprados
      document.getElementById('reset-bought-btn')?.addEventListener('click', () => {
        boughtIds.clear();
        saveBoughtState();
        currentStatusTab = 'pending';
        renderApp();
      });

      // Cerrar hoja de detalle
      document.getElementById('close-detail-modal')?.addEventListener('click', closeDetailModal);
      document.getElementById('close-detail-handle')?.addEventListener('click', closeDetailModal);
      document.getElementById('detail-modal')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeDetailModal();
      });

      document.getElementById('modal-toggle-btn')?.addEventListener('click', () => {
        if (activeModalProductId) {
          const id = activeModalProductId;
          closeDetailModal();
          toggleProductBought(id);
        }
      });

      document.getElementById('modal-delete-custom-btn')?.addEventListener('click', () => {
        if (activeModalProductId) {
          customItems = customItems.filter((item) => item.id !== activeModalProductId);
          boughtIds.delete(activeModalProductId);
          saveCustomItems();
          saveBoughtState();
          closeDetailModal();
          renderApp();
        }
      });

      // Modal Agregar Rápido
      const quickAddModal = document.getElementById('quick-add-modal');
      const quickAddForm = document.getElementById('quick-add-form') as HTMLFormElement | null;

      document.getElementById('open-quick-add-btn')?.addEventListener('click', () => {
        if (quickAddModal) {
          quickAddModal.hidden = false;
          quickAddModal.setAttribute('aria-hidden', 'false');
        }
      });

      const closeQuickAdd = () => {
        if (quickAddModal) {
          quickAddModal.hidden = true;
          quickAddModal.setAttribute('aria-hidden', 'true');
        }
      };

      document.getElementById('close-quick-add-modal')?.addEventListener('click', closeQuickAdd);
      quickAddModal?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeQuickAdd();
      });

      quickAddForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(quickAddForm);
        const name = String(formData.get('name') || '').trim();
        if (!name) return;

        const priceRaw = Number(formData.get('estimatedPrice') || 0);
        const category = String(formData.get('category') || 'Zapatos');
        const newItem: ProductItem = {
          id: 'custom-' + Date.now(),
          name,
          category,
          estimatedPrice: priceRaw > 0 ? priceRaw : undefined,
          spec: String(formData.get('spec') || '').trim() || undefined,
          colorway: String(formData.get('colorway') || '').trim() || undefined,
          storeHint: String(formData.get('storeHint') || '').trim() || undefined,
          image:
            String(formData.get('image') || '').trim() ||
            'https://images.unsplash.com/photo-1539185441755-769473a23570?auto=format&fit=crop&w=900&q=80',
          notes: String(formData.get('notes') || '').trim() || undefined,
          priority: 'alta',
        };

        customItems.unshift(newItem);
        saveCustomItems();
        quickAddForm.reset();
        closeQuickAdd();
        currentStatusTab = 'pending';
        currentCategory = 'Todos';
        renderApp();
      });
    }

    loadPersistedState();
    setupEvents();
    renderApp();
  </script>
</Layout>

